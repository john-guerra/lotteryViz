{
  "name": "lotteryv2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prestart": "node db/backup.mjs",
    "start": "node ./node_modules/nodemon/bin/nodemon.js ./bin/www.js",
    "dev": "node ./node_modules/nodemon/bin/nodemon.js ./bin/www.js",
    "backup": "node db/backup.mjs",
    "both": "yarn start & (cd front && yarn start)",
    "both:dev": "yarn dev & (cd front && yarn start)",
    "postinstall": "cd front && yarn install && yarn build",
    "test": "vitest run",
    "export-to-canvas": "node export-lottery-to-canvas.mjs",
    "check-slack": "node slack-checker/check-responses.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@observablehq/runtime": "5",
    "@slack/web-api": "^7.13.0",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "debug": "~2.6.9",
    "express": "^4.18.2",
    "less-middleware": "~2.2.1",
    "mongodb": "^3.5.2",
    "morgan": "~1.9.1",
    "nodemon": "^3.0.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "jsdom": "^30.0.1",
    "prettier": "^3.2.4",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">18.x"
  }
}
